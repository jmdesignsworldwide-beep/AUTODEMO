# ============================================================================
# JM AUTO — Variables de entorno (plantilla)
# Copia a .env.local y llena los valores. .env.local está en .gitignore.
# ============================================================================

# --- Públicas (seguras de exponer al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- SECRETA (Fort Knox pilar 1) ---
# La service_role SOLO va en el servidor. NUNCA con prefijo NEXT_PUBLIC_.
# En Vercel se marca como Sensitive. Jamás se sube al repo ni se pega en chat.
SUPABASE_SERVICE_ROLE=tu-service-role-key
